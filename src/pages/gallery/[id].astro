---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('gallery');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, pipeline, date, mediaType, src, poster, description, params, tags } = entry.data;
const base = import.meta.env.BASE_URL;

// Prev/next navigation in the same date-desc order as the gallery grid.
const all = (await getCollection('gallery')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const prevHref = prev ? `${base}gallery/${prev.id}/` : null;
const nextHref = next ? `${base}gallery/${next.id}/` : null;

const dateStr = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title={`${title} — Pasi`}>
  <main class="wrap wrap--wide entry-page">
    <div class="entry-head">
      <a class="back" href={`${base}gallery/`}>&larr; gallery</a>
      <span class="entry-meta">{pipeline} · {dateStr}</span>
    </div>
    <h1 class="entry-title">{title}</h1>

    <div class="entry">
      <div class="media-full">
        {mediaType === 'video' ? (
          <video src={src} poster={poster} controls loop playsinline />
        ) : (
          <img src={src} alt={title} />
        )}
      </div>

      <aside class="entry-side">
        {params && (
          <div class="stack">
            <span class="key">params:</span>
            {Object.entries(params).map(([k, v]) => <span class="tag">{k}={v}</span>)}
          </div>
        )}

        {tags.length > 0 && (
          <div class="stack">
            <span class="key">tags:</span>
            {tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}

        <div class="bio">
          {description && <p class="desc">{description}</p>}
          <Content />
        </div>
      </aside>
    </div>

    {prevHref && <a class="side-arrow side-prev" href={prevHref} aria-label={`Previous entry: ${prev.data.title}`}>&#8592;</a>}
    {nextHref && <a class="side-arrow side-next" href={nextHref} aria-label={`Next entry: ${next.data.title}`}>&#8594;</a>}

    <nav class="entry-nav" aria-label="Entry navigation">
      {prevHref ? (
        <a class="nav-arrow nav-prev" href={prevHref}>&larr; <span>{prev.data.title}</span></a>
      ) : (
        <span class="nav-arrow is-off" aria-hidden="true">&larr; start</span>
      )}
      {nextHref ? (
        <a class="nav-arrow nav-next" href={nextHref}><span>{next.data.title}</span> &rarr;</a>
      ) : (
        <span class="nav-arrow is-off" aria-hidden="true">end &rarr;</span>
      )}
    </nav>
  </main>

  <script>
    // Keyboard left/right navigation between gallery entries.
    const prevLink = document.querySelector('.nav-prev');
    const nextLink = document.querySelector('.nav-next');
    document.addEventListener('keydown', (e) => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable)) return;
      if (e.key === 'ArrowLeft' && prevLink) {
        e.preventDefault();
        window.location.href = prevLink.href;
      } else if (e.key === 'ArrowRight' && nextLink) {
        e.preventDefault();
        window.location.href = nextLink.href;
      }
    });

    // Touch swipe left/right (mobile): left = next, right = prev.
    let touchStartX = null;
    let touchStartY = null;
    let touchStartT = 0;
    let suppressClick = false;
    const SWIPE_MIN = 60;      // min horizontal px to count as a swipe
    const SWIPE_MAX_TIME = 600; // max ms for a swipe
    document.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      touchStartX = t.clientX;
      touchStartY = t.clientY;
      touchStartT = Date.now();
    }, { passive: true });
    document.addEventListener('touchend', (e) => {
      if (touchStartX === null) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      const dt = Date.now() - touchStartT;
      touchStartX = null;
      touchStartY = null;
      if (dt > SWIPE_MAX_TIME) return;
      if (Math.abs(dx) < SWIPE_MIN) return;
      if (Math.abs(dy) > Math.abs(dx) * 1.2) return; // vertical scroll, not a swipe
      if (dx < 0 && nextLink) {
        suppressClick = true;
        window.location.href = nextLink.href;
      } else if (dx > 0 && prevLink) {
        suppressClick = true;
        window.location.href = prevLink.href;
      }
    }, { passive: true });
    document.addEventListener('click', (e) => {
      if (suppressClick) {
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
      }
    }, true);
  </script>
</Layout>
