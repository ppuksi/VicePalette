---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('gallery');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, pipeline, date, mediaType, src, poster, params, tags } = entry.data;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${title} — Pasi`}>
  <main class="wrap wrap--wide">
    <a class="back" href={`${base}gallery/`}>&larr; gallery</a>
    <p class="eyebrow">{pipeline}</p>
    <h1>{title}</h1>
    <p class="tagline">
      {date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>

    <div class="media-full">
      {mediaType === 'video' ? (
        <video src={src} poster={poster} controls loop playsinline />
      ) : (
        <img src={src} alt={title} />
      )}
    </div>

    {params && (
      <div class="stack">
        <span class="key">params:</span>
        {Object.entries(params).map(([k, v]) => <span class="tag">{k}={v}</span>)}
      </div>
    )}

    {tags.length > 0 && (
      <div class="stack">
        <span class="key">tags:</span>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}

    <div class="bio">
      <Content />
    </div>
  </main>
</Layout>
