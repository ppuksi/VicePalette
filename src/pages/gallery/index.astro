---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('gallery')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pipelines = [...new Set(entries.map((e) => e.data.pipeline))].sort();
const base = import.meta.env.BASE_URL;
---

<Layout title="Gallery — Pasi" description="Output from local ComfyUI/LTX/Krea2/Wan pipelines.">
  <main class="wrap wrap--wide">
    <p class="eyebrow">// archive</p>
    <h1>Gallery</h1>
    <p class="tagline">Output from the local stack, filterable by pipeline.</p>

    <div class="filters" role="group" aria-label="Filter by pipeline">
      <button class="filter-btn is-active" data-filter="all">all</button>
      {pipelines.map((p) => <button class="filter-btn" data-filter={p}>{p}</button>)}
    </div>

    <div class="grid" id="gallery-grid">
      {entries.map((entry) => (
        <a class="card" href={`${base}gallery/${entry.id}/`} data-pipeline={entry.data.pipeline}>
          {entry.data.mediaType === 'video' ? (
            <video src={entry.data.src} poster={entry.data.poster} muted loop playsinline preload="metadata" />
          ) : (
            <img src={entry.data.thumb || entry.data.src} alt={entry.data.title} loading="lazy" />
          )}
          <div class="card-meta">
            <span class="card-title">{entry.data.title}</span>
            <span class="card-pipeline">{entry.data.pipeline}</span>
          </div>
        </a>
      ))}
    </div>

    <a class="back" href={base}>&larr; back</a>
  </main>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const filter = btn.getAttribute('data-filter');
        cards.forEach((card) => {
          const match = filter === 'all' || card.getAttribute('data-pipeline') === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
