---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('gallery')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pipelines = [...new Set(entries.map((e) => e.data.pipeline))].sort();

const monthKey = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const months = [...new Set(entries.map((e) => monthKey(e.data.date)))].sort().reverse();
const monthLabel = (m) => {
  const [y, mo] = m.split('-').map(Number);
  return new Date(y, mo - 1, 1).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
};
const base = import.meta.env.BASE_URL;
---

<Layout title="Gallery — Pasi" description="Output from local ComfyUI/LTX/Krea2/Wan pipelines.">
  <main class="wrap wrap--wide">
    <p class="eyebrow">// archive</p>
    <h1>Gallery</h1>
    <p class="tagline">Output from the local stack, filterable by pipeline.</p>

    <div class="filters" role="group" aria-label="Filter by pipeline">
      <button class="filter-btn is-active" data-filter="all" data-dim="pipeline">all</button>
      {pipelines.map((p) => <button class="filter-btn" data-filter={p} data-dim="pipeline">{p}</button>)}
    </div>

    <div class="filters" role="group" aria-label="Filter by month">
      <button class="filter-btn is-active" data-filter="all" data-dim="month">all time</button>
      {months.map((m) => <button class="filter-btn" data-filter={m} data-dim="month">{monthLabel(m)}</button>)}
    </div>

    <div class="grid" id="gallery-grid">
      {entries.map((entry) => (
        <a class="card" href={`${base}gallery/${entry.id}/`} data-pipeline={entry.data.pipeline} data-month={monthKey(entry.data.date)}>
          {entry.data.mediaType === 'video' ? (
            <video src={entry.data.src} poster={entry.data.poster} muted loop playsinline preload="metadata" />
          ) : (
            <img src={entry.data.thumb || entry.data.src} alt={entry.data.title} loading="lazy" />
          )}
          <div class="card-meta">
            <span class="card-title">{entry.data.title}</span>
            <span class="card-pipeline">{entry.data.pipeline}</span>
          </div>
        </a>
      ))}
    </div>

    <a class="back" href={base}>&larr; back</a>
  </main>

  <script>
    // Two independent filter dimensions (pipeline + month), combined with AND.
    const state = { pipeline: 'all', month: 'all' };
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dim = btn.getAttribute('data-dim') || 'pipeline';
        state[dim] = btn.getAttribute('data-filter');
        document.querySelectorAll(`.filter-btn[data-dim="${dim}"]`).forEach((b) =>
          b.classList.toggle('is-active', b === btn)
        );
        document.querySelectorAll('.card').forEach((card) => {
          const match =
            (state.pipeline === 'all' || card.dataset.pipeline === state.pipeline) &&
            (state.month === 'all' || card.dataset.month === state.month);
          card.style.display = match ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
